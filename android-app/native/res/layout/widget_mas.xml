<?xml version="1.0" encoding="utf-8"?>
<!-- Tamaño 1×1: un solo botón + que abre la ventana para apuntar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_mas"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_circulo_blanco"
        android:contentDescription="@string/widget_apuntar_cd"
        android:padding="12dp"
        android:src="@drawable/widget_ic_mas_negro" />
</FrameLayout>
